    "    red_mass = m1*m2/(m1+m2)\n",
    "    totmass = m1+m2\n",
    "    p = (L**2)/(red_mass*totmass*constants.G.number)\n",
    "\n",
    "    #COM v and r values\n",
    "    r_com = p/(1+eccentricity*np.cos(true_anom))\n",
    "    v_com = (constants.G.number*red_mass*totmass)/L\n",
