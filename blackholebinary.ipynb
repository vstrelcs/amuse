    "\n",
    "    #calculate eccentricity of the orbit\n",
    "    eccentricity = np.sqrt(1+((2*E*L**2)/((red_mass**3)*((m1+m2)**2)*constants.G.number)))\n",
    "\n",
    "    #given eccentricity and p (semi latus rectum) we can then get the true anomaly corresponding to the initial seperation\n",
    "    #we need this true anomaly to get the initial conditions for the run\n",
