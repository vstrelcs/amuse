    "from amuse.units import units, constants \n",
    "import numpy as np\n",
    "#These are hypothetical values for the system (will change accordingly)\n",
    "m1 = 10 | units.MSun                    # original black hole\n",
    "m2 = 1 | units.MSun                     # original companion star\n",
    "m3 = 10 | units.MSun                    # incoming black hole\n",
    "b = 1.5 | units.AU                       # impact parameter of the incoming black hole*                \n",
    "v_inf = 20 | units.kms                     # relative velocity of the incoming black hole*\n",
    "\n",
    "M12 = m1 + m2\n",
    "M_total = M12 +m3\n",
    "mu_out = (M12 * m3) / M_total\n",
    "\n",
    "#Incoming orbit relative to the original binary's center of mass\n",
    "E_out 0.5 * mu_out * v_inf**2\n",
    "L_out = mu_out * b * v_inf\n",
    "\n",
    "#Keplerian outer-orbit parameters\n",
    "e_out = np.sqrt(1 + (2 * E_out * L_out**2) / (mu_out ** 3 *(constants.G * M_total)**2))\n",
    "p_out = L_out**2 / (mu_out * constants.G * M_total)\n",
    "r_peri = p_out / (1 + e_out)\n",
    "print(\"Outer-orbit energy\", E_out)\n",
    "print(\"Outer angular momentum\", L_out)\n",
    "print(\"Outer-orbit eccentricity\", e_out)\n",
    "print(\"Pericenter:\", r_peri)\n"
   ]
