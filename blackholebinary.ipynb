    "def get_orb_params(m1, m2, E, L, initial_seperation):\n",
    "    \"\"\"given masses of the 2 objects (m2 being the 'incoming' object), total energy, total angular\n",
    "    momentum and the initial seperation, calculates corresponding eccentricity and true anomaly\"\"\"\n",
    "    \n",
    "    #needed values for calculation (reduced mass & semi latus rectum)\n",
    "    red_mass = m1*m2/(m1+m2)\n",
    "    p = (L**2)/(red_mass*(m1+m2)*constants.G)\n",
    "\n",
    "    #calculate eccentricity of the orbit\n",
    "    eccentricity = np.sqrt(1+((2*E*L**2)/((red_mass**3)*((m1+m2)**2)*constants.G)))\n",
    "\n",
    "    #given eccentricity and p (semi latus rectum) we can then get the true anomaly corresponding to the initial seperation\n",
    "    #we need this true anomaly to get the initial conditions for the run\n",
    "    true_anom = np.arccos((p-initial_seperation)/(initial_seperation*eccentricity))\n",
    "\n",
    "    return eccentricity, true_anom\n",
    "\n",
    "\n",
    "def get_initial_conditions(true_anom, eccentricity, m1, m2, L):\n",
    "    \"\"\"given the true anomaly and eccentricity of the orbit, and the two masses and total angular momentum\n",
    "    calculates the initial conditions in the COM frame (v1, r1, v2, r2)\"\"\"\n",
    "\n",
    "    #needed values for calculation (reduced mass, total mass & semi latus rectum)\n",
    "    red_mass = m1*m2/(m1+m2)\n",
    "    totmass = m1+m2\n",
    "    p = (L**2)/(red_mass*totmass*constants.G)\n",
    "\n",
    "    #COM v and r values\n",
    "    r_com = p/(1+eccentricity*np.cos(true_anom))\n",
    "    v_com = (constants.G*red_mass*totmass)/L\n",
    "\n",
    "    r_com_x = r_com*np.cos(true_anom)\n",
    "    r_com_y = r_com*np.sin(true_anom)\n",
    "    v_com_x = v_com*(-np.sin(true_anom))\n",
    "    v_com_y = v_com*(eccentricity+np.cos(true_anom))\n",
    "\n",
    "    #now converting these to r1, v1, r2, v2\n",
    "    r1_x = r_com_x*m2/totmass\n",
    "    r1_y = r_com_y*m2/totmass\n",
    "    r2_x = -r_com_x*m1/totmass\n",
    "    r2_y = -r_com_y*m1/totmass\n",
    "\n",
    "    v1_x = v_com_x*m2/totmass\n",
    "    v1_y = v_com_y*m2/totmass\n",
    "    v2_x = -v_com_x*m1/totmass\n",
    "    v2_y = -v_com_y*m1/totmass\n",
    "\n",
    "    return r1_x, r1_y, v1_x, v1_y, r2_x, r2_y, v2_x, v2_y"
   ]
