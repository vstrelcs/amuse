    "#for a 2 body system\n",
    "\n",
    "def initial_particleset_binary(m1, m2, E, L, initial_separation):\n",
    "    \"\"\"this defines (and returns) the particle set to evolve, given the masses, initial separation, energy and angular momentum\"\"\"\n",
    "    \n",
    "    #first get the necessary values\n",
    "    e, true_anom = get_orb_params(m1, m2, E, L, initial_separation)\n",
    "    r1_x, r1_y, v1_x, v1_y, r2_x, r2_y, v2_x, v2_y = get_initial_conditions(true_anom, e, m1, m2, L)\n",
    "\n",
    "    #then define the binary\n",
    "    two_black_holes = Particles(2)\n",
    "\n",
    "    # declare the first BH\n",
    "    bh1 = two_black_holes[0]\n",
    "    bh1.mass = m1 | units.kg\n",
    "    bh1.position = (r1_x, r1_y, 0) | units.m\n",
    "    bh1.velocity = (v1_x, v1_y, 0) | units.ms\n",
    "    #print(f\"bh1={bh1}\")\n",
    "\n",
    "    # declare the second BH\n",
    "    bh2 = two_black_holes[1]\n",
    "    bh2.mass = m2 | units.kg\n",
    "    bh2.position = (r2_x, r2_y, 0) | units.m\n",
    "    bh2.velocity = (v2_x, v2_y, 0) | units.ms\n",
    "    #print(f\"bh2={bh2}\")\n",
    "\n",
    "    two_black_holes.move_to_center()\n",
    "    #print(f'after moving to COM (should be unchanged): {two_black_holes}')\n",
    "\n",
    "    return two_black_holes"
   ]
